# Copia este archivo como ".env" y ajusta los valores
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=palmonte
DB_POOL_LIMIT=10

# Clave secreta para firmar tokens JWT
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_y_larga
JWT_EXPIRES_IN=7d

# Rate limiting (proteccion de fuerza bruta)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
